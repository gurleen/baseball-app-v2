# Port for the combined app + RPC + WebSocket server.
PORT=3030

# Replay recorded fixtures instead of calling MLB. The value is a fixture label
# under test/fixtures/ — "live" or "final". Useful out of season and offline.
# BASEBALL_REPLAY=live

# How many at-bats to rewind the replay before advancing one per poll.
# Also the replay's runway: 30 is about a minute at the live 2s cadence.
# BASEBALL_REPLAY_REWIND=30

# Override the Baseball Savant origin (defaults to https://baseballsavant.mlb.com).
# SAVANT_BASE_URL=
